# =====================================================================
# Kexvim API Keys 参考（data-example）
# 复制到 data/.env，填入自己的 key。填了的才能用对应 provider / 平台。
# 不用注释掉即可。本文件不入库（data/ 整体 gitignore）。
# =====================================================================

# ── LLM Providers ────────────────────────────────────────────
SCNET_TOKENS_API_KEY=XXX               # 超算互联网（scnet，OpenAI 兼容）
SCNET_API_KEY=XXX             # 超算互联网TOKEN_PLAN（scnet，OpenAI 兼容）
DEEPSEEK_API_KEY=XXX            # DeepSeek（国内）
OPENAI_API_KEY=XXX
ANTHROPIC_API_KEY=XXX           # Claude
GOOGLE_API_KEY=XXX              # Gemini（Google AI Studio）
DASHSCOPE_API_KEY=XXX           # 阿里云百炼（qwen / alibaba）
KIMI_API_KEY=XXX                # 月之暗面
MOONSHOT_API_KEY=XXX
GLM_API_KEY=XXX                 # 智谱（bigmodel）
ZAI_API_KEY=XXX                 # 智谱（zai）
MINIMAX_API_KEY=XXX             # MiniMax（国际）
MINIMAX_CN_API_KEY=XXX          # MiniMax（国内）
STEPFUN_API_KEY=XXX             # 阶跃星辰
OPENROUTER_API_KEY=XXX          # 聚合路由
XAI_API_KEY=XXX                 # xAI Grok
GROQ_API_KEY=XXX
TOGETHER_API_KEY=XXX
MISTRAL_API_KEY=XXX
NVIDIA_API_KEY=XXX              # NVIDIA NIM
FIREWORKS_API_KEY=XXX
HF_TOKEN=XXX                    # HuggingFace
CEREBRAS_API_KEY=XXX
DEEPINFRA_API_KEY=XXX
NOVITA_API_KEY=XXX
UPSTAGE_API_KEY=XXX
NOUS_API_KEY=XXX                # Nous Research 官方
XIAOMI_API_KEY=XXX              # 小米 MiMo
ARCEEAI_API_KEY=XXX
GMI_API_KEY=XXX

# ── 平台凭证（platform.adapters）─────────────────────────────
# 平台凭证也可直接写在 config.yaml 的 platform.adapters 里（如 QQ 的 app_id）
QQ_APP_ID=XXX
QQ_CLIENT_SECRET=XXX
TELEGRAM_TOKEN=XXX
DISCORD_TOKEN=XXX
WEIXIN_TOKEN=XXX
DINGTALK_CLIENT_ID=XXX
DINGTALK_CLIENT_SECRET=XXX
FEISHU_APP_ID=XXX
FEISHU_APP_SECRET=XXX

# ── 行为覆盖（可选）──────────────────────────────────────────
# KEXVIM_PROVIDER=deepseek      # 默认 provider（覆盖 config.yaml）
# KEXVIM_MODEL=deepseek-chat    # 默认模型（覆盖 config.yaml）
# KEXVIM_LANGUAGE=zh-CN         # 语言
# KEXVIM_USER_DATA_DIR=<项目根>/data
# KEXVIM_SKILLS_DIR=./skills    # 技能目录（默认 <项目根>/skills）
